# ================================================================
# SCIENCE DIVINE — ENVIRONMENT TEMPLATE (.env.example)
# ================================================================

# 1. OPENROUTER API KEY (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Divine AI Guide

# Free Models Configuration
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_CHAT_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_FALLBACK_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=
OPENROUTER_TTS_FORMAT=mp3

# Voice UX Settings
VOICE_AUTO_LISTEN=true
VOICE_AUTO_SPEAK=true
VOICE_INTERRUPTION=true
VOICE_VAD=true

# Optional ElevenLabs Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=gHu9GtaHOXcSqFTK06ux
