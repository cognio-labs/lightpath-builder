# ================================================================
# SCIENCE DIVINE — ENVIRONMENT TEMPLATE (.env.example)
# ================================================================

OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://lightpath-builder-main.vercel.app/
OPENROUTER_SITE_NAME=Divine AI Guide

# 🎙️ MODEL 1: VOICE MODE (Ultra-Fast 1-2 sentence real-time conversational model)
OPENROUTER_VOICE_MODEL=openrouter/free

# 💬 MODEL 2: CHAT MODE (Detailed, rich spiritual wisdom & structured text)
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free

# Fallbacks
OPENROUTER_CHAT_FALLBACK_MODEL=openrouter/free
OPENROUTER_VOICE_FALLBACK_MODEL=google/gemma-4-31b-it:free
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_FALLBACK_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=
OPENROUTER_TTS_FORMAT=mp3

# Voice UX Settings
VOICE_AUTO_LISTEN=true
VOICE_AUTO_SPEAK=true
VOICE_INTERRUPTION=true
VOICE_VAD=true

# Optional ElevenLabs Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=gHu9GtaHOXcSqFTK06ux
