# DataFast Analytics Configuration
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=true

# Razorpay Checkout (server-side only; never expose the secret in client code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiksha Sewa Sankalp Mahotsav: send the Entry Pass on WhatsApp via AiSensy
# (the pass is also emailed through RESEND_API_KEY).
AISENSY_API_KEY=
# A LIVE AiSensy "API campaign" whose template has an IMAGE header
AISENSY_CAMPAIGN_NAME=
# Optional: values for the template body variables, in order, comma-separated.
# Allowed: name, persons, date, time, venue, address, maps (Google Maps link), festival (default: name)
AISENSY_TEMPLATE_PARAMS=name
# Optional: public site URL WhatsApp downloads the pass image from (default https://sciencedivine.org)
MAHOTSAV_PUBLIC_BASE_URL=
