# Existing chat model configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_VOICE_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Science Divine

# Supabase server configuration for the private RAG index
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Protects POST /api/knowledge/ingest
KNOWLEDGE_INGEST_SECRET=
# Vercel Cron sends this value as a Bearer token. It can replace the ingest secret.
CRON_SECRET=

# Optional. OPENAI_API_KEY takes precedence for embeddings.
OPENAI_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=openai/text-embedding-3-small
